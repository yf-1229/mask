# Security headers for the mask site.
#
# The Worker serves the assets at the root of its own hostname
# (https://mask.branchead.com/), so the pattern is /*.
#
# The CSP is deliberately strict: each page is a single file with inline style,
# system fonts, no images beyond its own OGP card and no JavaScript at all. There
# is no network endpoint in the policy, so "no external requests" is enforced
# rather than promised.

/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
